VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend API base URL (no trailing slash).
# Local dev (docker-compose.yml maps app to host port 8100):  http://localhost:8100
# Docker prod tunnel: get URL from `docker compose -f docker-compose.prod.yml logs -f cloudflare`
# Vercel: set this as an environment variable in the Vercel project dashboard instead of here.
VITE_API_URL=http://localhost:8100

VITE_APP_NAME=NexaDesk
