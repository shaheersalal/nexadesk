# ── App ───────────────────────────────────────────
APP_NAME=NexaDesk
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
APP_BASE_URL=http://localhost:8000
SUPPORTED_LANGUAGES=en,es,ar,fr,ur

# ── LLM ──────────────────────────────────────────
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# ── Speech-to-Text (Deepgram) ─────────────────────
STT_API_KEY=
STT_MODEL=nova-2

# ── Text-to-Speech (ElevenLabs) ───────────────────
TTS_API_KEY=
TTS_MODEL=eleven_turbo_v2
TTS_VOICE_ID=

# ── Embeddings (OpenAI or compatible) ────────────
EMBED_API_KEY=
EMBED_MODEL=text-embedding-3-small
EMBED_DIMENSIONS=1536

# ── Telephony (Twilio) ───────────────────────────
TELEPHONY_ACCOUNT_SID=
TELEPHONY_AUTH_TOKEN=
TELEPHONY_PHONE_NUMBER=
TELEPHONY_WEBHOOK_BASE_URL=

# ── Supabase (managed) ───────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ── Vector DB (Qdrant, self-hosted) ──────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=nexadesk_kb

# ── Redis ─────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Google Calendar (optional) ────────────────────
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/leads/calendar/callback

# ── Upload ────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50

# ── Jina AI (re-ranking, optional) ────────────────
JINA_API_KEY=
JINA_RERANKER_MODEL=jina-reranker-v2-base-multilingual
