# ── App ───────────────────────────────────────────
APP_NAME=NexaDesk
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
APP_BASE_URL=http://localhost:8000
SUPPORTED_LANGUAGES=en,es,ar,fr,ur

# ── LLM ──────────────────────────────────────────
# app/shared/llm.py talks to the OpenAI SDK, so this must be an OpenAI
# model id. The old `claude-sonnet-4-6` default here failed at the first
# LLM call on any deploy that did not override it (AUDIT.md M13).
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── Speech-to-Text (Deepgram) ─────────────────────
STT_API_KEY=
STT_MODEL=nova-2

# ── Text-to-Speech (ElevenLabs) ───────────────────
TTS_API_KEY=
TTS_MODEL=eleven_turbo_v2_5
TTS_VOICE_ID=

# ── Embeddings (OpenAI or compatible) ────────────
EMBED_API_KEY=
EMBED_MODEL=text-embedding-3-small
EMBED_DIMENSIONS=1536

# ── Telephony (Twilio) ───────────────────────────
TELEPHONY_ACCOUNT_SID=
TELEPHONY_AUTH_TOKEN=
TELEPHONY_PHONE_NUMBER=
TELEPHONY_WEBHOOK_BASE_URL=

# ── Supabase (managed) ───────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ── Vector DB (Qdrant Cloud) ─────────────────────
# Set QDRANT_URL + QDRANT_API_KEY for managed Qdrant Cloud (the deployed
# setup). QDRANT_HOST/PORT are only used when QDRANT_URL is empty, which
# is now purely a local-development fallback.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=nexadesk_kb

# ── Redis (Upstash) ───────────────────────────────
# Upstash requires TLS — the scheme must be rediss:// (two s).
REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# ── Google Calendar (optional) ────────────────────
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/leads/calendar/callback

# ── Upload ────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50

# ── Jina AI (re-ranking, optional) ────────────────
JINA_API_KEY=
JINA_RERANKER_MODEL=jina-reranker-v2-base-multilingual
