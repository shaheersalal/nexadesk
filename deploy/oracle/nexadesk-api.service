[Unit]
Description=NexaDesk FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/nexadesk/app
Environment=TIKTOKEN_CACHE_DIR=/opt/nexadesk/app/.tiktoken_cache
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/nexadesk/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
RestartSec=5
# Same 2-worker count as railway.json — Always Free's 12GB is plenty, but the
# webhook retry loop is per-worker (AUDIT.md H6) so more workers means more
# duplicate deliveries until that's fixed with a lock.

[Install]
WantedBy=multi-user.target
